  <step>
    <name>Table input</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>new_procurement</connection>
    <sql>
SELECT
    s.inventory_id,
    po.po_key,
    w.warehouse_key,
    d.date_key AS snapshot_date_key,
    s.product_id,
    s.opening_stock,
    s.stock_in,
    s.stock_out,
    s.closing_stock,
    s.reorder_level,
    s.safety_stock,
    s.inventory_value_inr,
    s.capacity_utilization_percent
FROM staging.inventory s
JOIN dw.dim_purchase_order po
    ON po.po_id = s.po_id
JOIN dw.dim_warehouse w
    ON w.warehouse_id = s.warehouse_id
JOIN dw.dim_date d
    ON d.full_date = s.snapshot_date
WHERE NOT EXISTS (
    SELECT 1
    FROM dw.fact_inventory f
    WHERE f.inventory_id = s.inventory_id
);
</sql>
    <limit>0</limit>
