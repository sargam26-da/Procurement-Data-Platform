    <connection>procurement_db</connection>
    <sql>
SELECT
    s.invoice_id,
    po.po_key,
    sup.supplier_key,
    idate.date_key AS invoice_date_key,
    rdate.date_key AS receipt_date_key,
    duedate.date_key AS due_date_key,
    paiddate.date_key AS paid_date_key,
    s.invoice_amount_inr,
    s.exchange_rate_to_inr,
    s.currency,
    s.payment_status,
    s.matching_status,
    s.invoice_approval_status
FROM staging.invoices s
JOIN dw.dim_purchase_order po
    ON po.po_id = s.po_id
JOIN dw.dim_supplier sup
    ON sup.supplier_id = s.supplier_id
JOIN dw.dim_date idate
    ON idate.full_date = s.invoice_date
LEFT JOIN dw.dim_date rdate
    ON rdate.full_date = s.receipt_date
LEFT JOIN dw.dim_date duedate
    ON duedate.full_date = s.due_date
LEFT JOIN dw.dim_date paiddate
    ON paiddate.full_date =
       CASE
           WHEN s.paid_date ~ '^\d{4}/\d{2}/\d{2}'
           THEN TO_DATE(
               SPLIT_PART(s.paid_date, ' ', 1),
               'YYYY/MM/DD'
           )
           ELSE NULL
       END
WHERE NOT EXISTS (
    SELECT 1
    FROM dw.fact_invoice f
    WHERE f.invoice_id = s.invoice_id
);
</sql>
